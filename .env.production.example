APP_NAME="Swimming Up"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_DOMAIN=swimmingup.hopto.org
APP_URL=https://swimmingup.hopto.org/admin
ASSET_URL=https://swimmingup.hopto.org/admin
HTTP_PORT=80

VITE_API_BASE_URL=/api

LOG_CHANNEL=stderr
LOG_LEVEL=warning
SESSION_DRIVER=file
SESSION_DOMAIN=swimmingup.hopto.org
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
RUN_MIGRATIONS=false

POSTGRES_DB=swimmingup
POSTGRES_USER=swimmingup_auth_user
POSTGRES_PASSWORD=change_me_postgres

MARIADB_DATABASE=swimmingup
MARIADB_USER=swimmingup_app_user
MARIADB_PASSWORD=change_me_mariadb
MARIADB_ROOT_PASSWORD=change_me_root

WORDPRESS_DB_NAME=swimmingup_wordpress
WORDPRESS_DB_USER=swimmingup_wp_user
WORDPRESS_DB_PASSWORD=change_me_wordpress
WP_HOME=https://swimmingup.hopto.org/blog
WP_SITEURL=https://swimmingup.hopto.org/blog
WP_CONTENT_URL=https://swimmingup.hopto.org/blog/wp-content

PHPMYADMIN_PORT=8081
PHPMYADMIN_UPLOAD_LIMIT=64M
PMA_ABSOLUTE_URI=https://localhost:8081/
